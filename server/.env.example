# Скопируй этот файл в .env и подставь свои значения.
# Сам .env в git не попадает (он в .gitignore) — на хостинге эти переменные
# задаются руками в настройках сервиса.

# Строка подключения к MongoDB.
# Локально: mongodb://127.0.0.1:27017/carshop
# На проде: строка из MongoDB Atlas
DATABASE_URL=mongodb+srv://alka030505_db_user:<db_password>@carshop.kyj0b50.mongodb.net/?appName=carshop

# Длинная случайная строка для подписи токенов. На проде ОБЯЗАТЕЛЬНО другая, не эта.
# Сгенерировать: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me_to_a_long_random_string

JWT_EXPIRE=15m
JWT_REFRESH_EXPIRE=20d

# Порт. Локально 3000, на хостинге переменную задаёт сам хостинг — трогать не нужно.
PORT=3000

# Адрес фронтенда, которому разрешён доступ к API (CORS).
# Несколько адресов пишутся через запятую.
# Если оставить пустым — пускает всех (удобно локально, но не для прода).
CLIENT_URL=http://localhost:5173

# Google Sign-In. Тот же Client ID, что вшит во фронтенде (main.tsx).
# Берётся в Google Cloud Console -> Credentials -> OAuth 2.0 Client ID.
# Не забудь добавить адрес задеплоенного фронтенда в "Authorized JavaScript origins",
# иначе кнопка Google работать не будет.
GOOGLE_CLIENT_ID=

# Cloudinary — хранилище картинок.
# Если эти три переменные заданы, картинки уезжают в облако и переживают перезапуск сервера.
# Если не заданы — файлы сохраняются в папку uploads (годится только для локальной работы,
# на хостинге такие файлы стираются при каждом деплое).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
