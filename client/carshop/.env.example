# Скопируй в .env и подставь адрес своего бэкенда.
# Локально сервер обычно на http://localhost:3000 — это значение подставляется само,
# если переменной нет, так что локально файл можно и не создавать.
# На Vercel эту переменную нужно задать в настройках проекта (Settings -> Environment Variables).
#
# ВАЖНО: без слэша в конце и обязательно с https:// на проде.
VITE_API_URL=http://localhost:3000
